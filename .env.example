# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
# Токен бота, полученный у @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram ID администратора (или ID группы) для получения уведомлений о заказах
ADMIN_CHAT_ID=123456789

# URL развернутого WebApp (https://...), который открывается по кнопке в боте
WEBAPP_URL=https://your-domain.com

# ==============================================================================
# Backend & Server Configuration
# ==============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=True

# База данных (по умолчанию быстрый локальный SQLite в асинхронном режиме)
# Для PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/shop_db
DATABASE_URL=sqlite+aiosqlite:///./shop.db

# ==============================================================================
# Google Sheets API Configuration
# ==============================================================================
# Путь к JSON-файлу сервисного аккаунта Google Cloud
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google_service_account.json

# ID таблицы Google Sheets (из URL: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit)
GOOGLE_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms

# Название рабочего листа с товарами
GOOGLE_SHEET_NAME=Товары

# Интервал автосинхронизации с Google Sheets в секундах (по умолчанию 300 сек / 5 мин)
SYNC_INTERVAL_SECONDS=300

# ==============================================================================
# Store & Payment Requisites (Реквизиты для оплаты)
# ==============================================================================
# Настройки СБП
SBP_PHONE=+7 (999) 000-00-00
SBP_BANK=Т-Банк / Сбер
SBP_RECEIVER_NAME=Иван И.

# Криптокошельки
CRYPTO_TON_WALLET=EQD1234567890abcdef1234567890abcdef1234567890abc
CRYPTO_USDT_TON_WALLET=EQD1234567890abcdef1234567890abcdef1234567890abc
CRYPTO_USDT_TRC20_WALLET=TXYZ1234567890abcdef1234567890abcdef123

# Точка самовывоза
PICKUP_ADDRESS=г. Москва, ул. Примерная, д. 10, оф. 205
PICKUP_WORKING_HOURS=Пн-Пт: 10:00 - 20:00, Сб-Вс: 11:00 - 18:00
PICKUP_INSTRUCTIONS=Для входа наберите на домофоне 205 или позвоните менеджеру за 15 минут.
